{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KokunoYumeto/mathematics-commons-pilot/main/schemas/problem-record.schema.json",
  "title": "Mathematics Commons problem record",
  "description": "A versioned, source-bound record for one durable mathematical subject. Status is a dated qualified assessment, not a consequence of tracker labels or model agreement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_version",
    "problem_id",
    "previous_problem_ref",
    "project_id",
    "kind",
    "title",
    "statement",
    "current_status",
    "source_refs",
    "provenance",
    "definitions_and_conventions",
    "created_at",
    "updated_at",
    "responsible_steward_id",
    "submission_boundary",
    "submission_rights",
    "limitations"
  ],
  "properties": {
    "record_type": {
      "const": "problem_record"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "record_version": {
      "$ref": "#/$defs/semver"
    },
    "problem_id": {
      "$ref": "#/$defs/stable_id"
    },
    "previous_problem_ref": {
      "description": "Exact predecessor in this stable problem's immutable no-fork version lineage; null only for the root version.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/problem_reference"
        }
      ]
    },
    "project_id": {
      "$ref": "#/$defs/stable_id"
    },
    "kind": {
      "enum": [
        "established_open_problem",
        "community_conjecture",
        "calibration",
        "known_result",
        "historical_problem",
        "literature_status_question",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_path",
        "artifact_version",
        "statement_label",
        "media_type",
        "language",
        "byte_size",
        "hashes",
        "exactness",
        "change_policy"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "artifact_path": {
          "$ref": "#/$defs/repository_path"
        },
        "artifact_version": {
          "$ref": "#/$defs/semver"
        },
        "statement_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        },
        "exactness": {
          "const": "canonical_project_statement",
          "description": "MVP-safe mode: the checked-in statement is Commons-originated canonical wording. Verbatim or normalized third-party wording requires a later origin/rights contract and cannot be CC0-mislabeled here."
        },
        "change_policy": {
          "const": "new_record_version_required"
        }
      }
    },
    "current_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "qualified_label",
        "assessed_at",
        "assessor_id",
        "assessment_method",
        "basis_source_ids",
        "basis_summary",
        "status_scope",
        "tracker_or_model_agreement_sufficient",
        "independent_verification_status",
        "caveats"
      ],
      "properties": {
        "assessment": {
          "enum": [
            "open",
            "solved",
            "disproved",
            "known_result",
            "uncertain",
            "not_assessed"
          ]
        },
        "qualified_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "assessed_at": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "assessor_id": {
          "$ref": "#/$defs/stable_id"
        },
        "assessment_method": {
          "enum": [
            "independent_literature_review",
            "human_expert_review",
            "source_verified_known_result",
            "calibration_designation",
            "mixed_evidence_review"
          ]
        },
        "basis_source_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "basis_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "status_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tracker_or_model_agreement_sufficient": {
          "const": false
        },
        "independent_verification_status": {
          "enum": [
            "verified",
            "partially_verified",
            "pending"
          ]
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source_reference"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/provenance_entry"
      }
    },
    "definitions_and_conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_scope",
        "definitions",
        "conventions"
      ],
      "properties": {
        "statement_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/definition_entry"
          }
        },
        "conventions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/convention_entry"
          }
        }
      }
    },
    "created_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "responsible_steward_id": {
      "$ref": "#/$defs/stable_id"
    },
    "submission_boundary": {
      "$ref": "#/$defs/submission_boundary"
    },
    "submission_rights": {
      "$ref": "#/$defs/submission_rights"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "problem_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "problem_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "record_version",
        "hashes",
        "roles",
        "permitted_uses"
      ],
      "properties": {
        "source_record_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "statement_authority",
              "status_basis",
              "provenance_basis",
              "definition_basis",
              "rights_basis",
              "historical_context"
            ]
          }
        },
        "permitted_uses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inspect",
              "quote_lawful_excerpt",
              "extract_facts",
              "compute",
              "translate",
              "redistribute",
              "model_training"
            ]
          }
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      }
    },
    "provenance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "kind",
        "description",
        "originator_label",
        "attribution_status",
        "publication_basis",
        "source_record_ids",
        "recorded_at"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/stable_id"
        },
        "kind": {
          "enum": [
            "idea_origin",
            "problem_nomination",
            "statement_origin",
            "status_assessment",
            "prior_result",
            "prior_attempt",
            "workflow_proposal",
            "source_lead",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "originator_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "attribution_status": {
          "enum": [
            "verified",
            "reported",
            "uncertain",
            "not_applicable"
          ]
        },
        "publication_basis": {
          "enum": [
            "public_record",
            "public_domain",
            "permission",
            "commons_submission",
            "metadata_only"
          ]
        },
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "recorded_at": {
          "$ref": "#/$defs/utc_timestamp"
        }
      }
    },
    "definition_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "meaning",
        "source_record_ids"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_record_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      }
    },
    "convention_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "text",
        "source_record_ids"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "source_record_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "none_identified",
            "known",
            "not_assessed"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "submission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_by_default",
        "schema_fields_are_public_allowlist",
        "allowlisted_artifact_ids",
        "excluded_from_submission_by_default",
        "raw_interaction_records_required",
        "redaction_status",
        "publication_preview_status",
        "retention_rule"
      ],
      "properties": {
        "private_by_default": {
          "const": true
        },
        "schema_fields_are_public_allowlist": {
          "const": true
        },
        "allowlisted_artifact_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "excluded_from_submission_by_default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_transcript",
            "prompt_history",
            "chain_of_thought",
            "private_notes",
            "unpublished_communications",
            "personal_context",
            "credentials",
            "unrelated_local_files"
          ],
          "properties": {
            "raw_transcript": {
              "const": true
            },
            "prompt_history": {
              "const": true
            },
            "chain_of_thought": {
              "const": true
            },
            "private_notes": {
              "const": true
            },
            "unpublished_communications": {
              "const": true
            },
            "personal_context": {
              "const": true
            },
            "credentials": {
              "const": true
            },
            "unrelated_local_files": {
              "const": true
            }
          }
        },
        "raw_interaction_records_required": {
          "const": false
        },
        "redaction_status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "publication_preview_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "retention_rule": {
          "enum": [
            "approved_submission_only",
            "metadata_only",
            "time_limited"
          ]
        }
      }
    },
    "submission_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commons_originated_record",
        "dedication",
        "dedication_scope",
        "submitted_component_ids",
        "third_party_rights_preserved",
        "third_party_source_ids",
        "redistribution_status"
      ],
      "properties": {
        "commons_originated_record": {
          "const": true
        },
        "dedication": {
          "const": "CC0-1.0"
        },
        "dedication_scope": {
          "const": "intentionally_submitted_commons_components_only"
        },
        "submitted_component_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "third_party_rights_preserved": {
          "const": true
        },
        "third_party_source_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "redistribution_status": {
          "enum": [
            "permitted",
            "restricted",
            "unresolved",
            "metadata_only"
          ]
        }
      }
    }
  }
}
