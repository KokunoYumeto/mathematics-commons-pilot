{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KokunoYumeto/mathematics-commons-pilot/main/schemas/run-record.schema.json",
  "title": "Mathematics Commons Run and Tool-Disclosure Record",
  "description": "A sanitized account of material human and tool activity for one packet run; it is not an interaction transcript.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_version",
    "run_id",
    "packet_ref",
    "status",
    "started_at",
    "recorded_at",
    "elapsed_seconds",
    "responsible_operator_id",
    "responsibility_statement",
    "functional_task_specification",
    "disclosure_attestation",
    "tool_disclosures",
    "material_human_interventions",
    "input_artifacts",
    "output_artifacts",
    "workspace_revision",
    "reproduction_steps",
    "checks",
    "resources",
    "disclosure_gaps",
    "submission_boundary",
    "submission_rights",
    "limitations"
  ],
  "properties": {
    "record_type": {
      "const": "run_record"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "record_version": {
      "$ref": "#/$defs/semver"
    },
    "run_id": {
      "$ref": "#/$defs/stable_id"
    },
    "packet_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "partial",
        "failed",
        "aborted",
        "superseded"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 2592000
    },
    "responsible_operator_id": {
      "$ref": "#/$defs/stable_id"
    },
    "responsibility_statement": {
      "type": "string",
      "minLength": 1
    },
    "functional_task_specification": {
      "type": "string",
      "minLength": 1
    },
    "disclosure_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sanitized_task_conditions_supplied",
        "material_tool_use_disclosed",
        "material_human_interventions_disclosed",
        "raw_prompt_history_required",
        "raw_transcript_required",
        "claim_depends_on_undisclosed_private_material"
      ],
      "properties": {
        "sanitized_task_conditions_supplied": {
          "const": true
        },
        "material_tool_use_disclosed": {
          "const": true
        },
        "material_human_interventions_disclosed": {
          "const": true
        },
        "raw_prompt_history_required": {
          "const": false
        },
        "raw_transcript_required": {
          "const": false
        },
        "claim_depends_on_undisclosed_private_material": {
          "const": false
        }
      }
    },
    "tool_disclosures": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "category",
          "name",
          "version",
          "version_status",
          "role",
          "execution_location",
          "network_used",
          "provider",
          "data_sent_categories",
          "provider_retention_status",
          "provider_training_use_status",
          "limitations"
        ],
        "properties": {
          "tool_id": {
            "$ref": "#/$defs/stable_id"
          },
          "category": {
            "enum": [
              "ai_model",
              "agent_client",
              "proof_assistant",
              "solver",
              "library",
              "language_runtime",
              "search_service",
              "database",
              "editor",
              "other"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "version_status": {
            "enum": [
              "exact",
              "provider_label_only",
              "unavailable",
              "unknown"
            ]
          },
          "role": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "literature_search",
                "source_retrieval",
                "generation",
                "critique",
                "computation",
                "code_generation",
                "formalization",
                "translation",
                "transcription",
                "rendering",
                "validation",
                "other"
              ]
            }
          },
          "execution_location": {
            "enum": [
              "local",
              "remote",
              "local_client_remote_inference",
              "hybrid",
              "unknown"
            ]
          },
          "network_used": {
            "type": "boolean"
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "data_sent_categories": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "enum": [
                "none",
                "sanitized_task_specification",
                "public_source_text",
                "lawful_source_excerpt",
                "commons_artifact",
                "code",
                "formal_files",
                "other_reviewed_input"
              ]
            }
          },
          "provider_retention_status": {
            "enum": [
              "not_applicable",
              "terms_checked",
              "not_checked",
              "unknown"
            ]
          },
          "provider_training_use_status": {
            "enum": [
              "not_applicable",
              "disabled",
              "permitted_by_operator",
              "provider_terms_apply",
              "unknown"
            ]
          },
          "limitations": {
            "$ref": "#/$defs/limitations"
          }
        }
      }
    },
    "material_human_interventions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intervention_id",
          "role",
          "description"
        ],
        "properties": {
          "intervention_id": {
            "$ref": "#/$defs/stable_id"
          },
          "role": {
            "enum": [
              "task_selection",
              "scope_change",
              "source_selection",
              "method_selection",
              "correction",
              "artifact_editing",
              "result_interpretation",
              "self_check",
              "submission_approval",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact_reference"
      }
    },
    "output_artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact_reference"
      }
    },
    "workspace_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_control",
        "revision",
        "working_tree_status"
      ],
      "properties": {
        "version_control": {
          "enum": [
            "git",
            "other",
            "none"
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "working_tree_status": {
          "enum": [
            "clean",
            "modified",
            "not_applicable",
            "unknown"
          ]
        }
      }
    },
    "reproduction_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "description",
          "expected_result"
        ],
        "properties": {
          "step_id": {
            "$ref": "#/$defs/stable_id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sanitized_command_or_query": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/check_result"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_envelope",
        "network_calls_status",
        "compute_summary",
        "monetary_cost_status",
        "energy_reporting_status"
      ],
      "properties": {
        "resource_envelope": {
          "enum": [
            "light",
            "standard",
            "extended",
            "specialized"
          ]
        },
        "network_calls_status": {
          "enum": [
            "none",
            "bounded_and_disclosed",
            "incompletely_known"
          ]
        },
        "compute_summary": {
          "type": "string",
          "minLength": 1
        },
        "monetary_cost_status": {
          "enum": [
            "not_applicable",
            "within_approved_budget",
            "exceeded_approved_budget",
            "unknown"
          ]
        },
        "energy_reporting_status": {
          "enum": [
            "not_proportionate",
            "reported",
            "estimate_unavailable"
          ]
        },
        "paid_spend": {
          "description": "Actual paid spend in USD for this run.",
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "peak_ram_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1125899906842624
        },
        "gpu_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1125899906842624
        },
        "upload_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1125899906842624
        }
      }
    },
    "disclosure_gaps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "description",
          "reason",
          "effect_on_claim"
        ],
        "properties": {
          "gap_id": {
            "$ref": "#/$defs/stable_id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "privacy",
              "confidentiality",
              "security",
              "third_party_rights",
              "provider_unavailability",
              "not_recorded",
              "other"
            ]
          },
          "effect_on_claim": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "submission_boundary": {
      "$ref": "#/$defs/submission_boundary"
    },
    "submission_rights": {
      "$ref": "#/$defs/submission_rights"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "method",
        "status",
        "evidence_artifact_refs",
        "notes"
      ],
      "properties": {
        "check_id": {
          "$ref": "#/$defs/stable_id"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "inconclusive"
          ]
        },
        "evidence_artifact_refs": {
          "description": "Cycle-safe exact artifact references: evidence record ID/version plus the exact artifact-byte digest, not the evidence-record digest.",
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_reference"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "none_identified",
            "known",
            "not_assessed"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "submission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_by_default",
        "schema_fields_are_public_allowlist",
        "allowlisted_artifact_ids",
        "excluded_from_submission_by_default",
        "raw_interaction_records_required",
        "redaction_status",
        "publication_preview_status",
        "retention_rule"
      ],
      "properties": {
        "private_by_default": {
          "const": true
        },
        "schema_fields_are_public_allowlist": {
          "const": true
        },
        "allowlisted_artifact_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "excluded_from_submission_by_default": {
          "$ref": "#/$defs/private_exclusions"
        },
        "raw_interaction_records_required": {
          "const": false
        },
        "redaction_status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "publication_preview_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "retention_rule": {
          "enum": [
            "approved_submission_only",
            "metadata_only",
            "time_limited"
          ]
        }
      }
    },
    "private_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_transcript",
        "prompt_history",
        "chain_of_thought",
        "private_notes",
        "unpublished_communications",
        "personal_context",
        "credentials",
        "unrelated_local_files"
      ],
      "properties": {
        "raw_transcript": {
          "const": true
        },
        "prompt_history": {
          "const": true
        },
        "chain_of_thought": {
          "const": true
        },
        "private_notes": {
          "const": true
        },
        "unpublished_communications": {
          "const": true
        },
        "personal_context": {
          "const": true
        },
        "credentials": {
          "const": true
        },
        "unrelated_local_files": {
          "const": true
        }
      }
    },
    "submission_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commons_originated_record",
        "dedication",
        "dedication_scope",
        "submitted_component_ids",
        "third_party_rights_preserved",
        "third_party_source_ids",
        "redistribution_status"
      ],
      "properties": {
        "commons_originated_record": {
          "const": true
        },
        "dedication": {
          "const": "CC0-1.0"
        },
        "dedication_scope": {
          "const": "intentionally_submitted_commons_components_only"
        },
        "submitted_component_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "third_party_rights_preserved": {
          "const": true
        },
        "third_party_source_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "redistribution_status": {
          "enum": [
            "permitted",
            "restricted",
            "unresolved",
            "metadata_only"
          ]
        }
      }
    }
  }
}
