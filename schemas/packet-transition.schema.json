{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KokunoYumeto/mathematics-commons-pilot/main/schemas/packet-transition.schema.json",
  "title": "Mathematics Commons packet transition",
  "description": "One immutable, append-only, version-bound Research Packet state event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_version",
    "transition_id",
    "event_model",
    "event_kind",
    "from_packet_ref",
    "to_packet_ref",
    "sequence",
    "from_status",
    "to_status",
    "actor_id",
    "occurred_at",
    "git_commit",
    "reason",
    "next_owner_id",
    "submission_boundary",
    "submission_rights",
    "limitations"
  ],
  "properties": {
    "record_type": {
      "const": "packet_transition"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "record_version": {
      "$ref": "#/$defs/semver"
    },
    "transition_id": {
      "$ref": "#/$defs/stable_id"
    },
    "event_model": {
      "const": "append_only"
    },
    "event_kind": {
      "enum": [
        "state_transition",
        "record_revision",
        "lease_update"
      ],
      "description": "Distinguishes lifecycle state changes from same-status immutable revisions and lease updates."
    },
    "from_packet_ref": {
      "$ref": "#/$defs/packet_reference",
      "description": "Exact immutable Research Packet snapshot before this event."
    },
    "to_packet_ref": {
      "$ref": "#/$defs/packet_reference",
      "description": "Exact immutable Research Packet snapshot created for the state after this event."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "from_status": {
      "$ref": "#/$defs/packet_status"
    },
    "to_status": {
      "$ref": "#/$defs/packet_status"
    },
    "actor_id": {
      "$ref": "#/$defs/stable_id"
    },
    "occurred_at": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Exact repository state/basis commit for the transition. It need not contain this append-only event record, avoiding an impossible self-reference."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "next_owner_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_reference"
      }
    },
    "review_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/review_reference"
      }
    },
    "submission_boundary": {
      "$ref": "#/$defs/submission_boundary"
    },
    "submission_rights": {
      "$ref": "#/$defs/submission_rights"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "packet_status": {
      "enum": [
        "draft",
        "ready",
        "claimed",
        "in_progress",
        "blocked",
        "submitted",
        "under_review",
        "accepted",
        "rejected",
        "challenged",
        "superseded",
        "withdrawn",
        "closed"
      ]
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "packet_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "evidence_reference": {
      "description": "Exact evidence-record identity; hashes bind the complete normalized JSON record, not only its artifact bytes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "review_reference": {
      "description": "Exact review-record identity with a complete normalized-record digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "none_identified",
            "known",
            "not_assessed"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "submission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_by_default",
        "schema_fields_are_public_allowlist",
        "allowlisted_artifact_ids",
        "excluded_from_submission_by_default",
        "raw_interaction_records_required",
        "redaction_status",
        "publication_preview_status",
        "retention_rule"
      ],
      "properties": {
        "private_by_default": {
          "const": true
        },
        "schema_fields_are_public_allowlist": {
          "const": true
        },
        "allowlisted_artifact_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "excluded_from_submission_by_default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_transcript",
            "prompt_history",
            "chain_of_thought",
            "private_notes",
            "unpublished_communications",
            "personal_context",
            "credentials",
            "unrelated_local_files"
          ],
          "properties": {
            "raw_transcript": {
              "const": true
            },
            "prompt_history": {
              "const": true
            },
            "chain_of_thought": {
              "const": true
            },
            "private_notes": {
              "const": true
            },
            "unpublished_communications": {
              "const": true
            },
            "personal_context": {
              "const": true
            },
            "credentials": {
              "const": true
            },
            "unrelated_local_files": {
              "const": true
            }
          }
        },
        "raw_interaction_records_required": {
          "const": false
        },
        "redaction_status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "publication_preview_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "retention_rule": {
          "enum": [
            "approved_submission_only",
            "metadata_only",
            "time_limited"
          ]
        }
      }
    },
    "submission_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commons_originated_record",
        "dedication",
        "dedication_scope",
        "submitted_component_ids",
        "third_party_rights_preserved",
        "third_party_source_ids",
        "redistribution_status"
      ],
      "properties": {
        "commons_originated_record": {
          "const": true
        },
        "dedication": {
          "const": "CC0-1.0"
        },
        "dedication_scope": {
          "const": "intentionally_submitted_commons_components_only"
        },
        "submitted_component_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "third_party_rights_preserved": {
          "const": true
        },
        "third_party_source_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "redistribution_status": {
          "enum": [
            "permitted",
            "restricted",
            "unresolved",
            "metadata_only"
          ]
        }
      }
    }
  }
}
