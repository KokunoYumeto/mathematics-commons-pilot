{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-pilot/raw/main/schemas/edu.schema.json",
  "title": "Mathematics Commons education translation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated",
    "purpose",
    "language_access",
    "materials",
    "workflow",
    "starter",
    "research_report",
    "indonesian_program",
    "highlighted_example"
  ],
  "properties": {
    "schema": {
      "const": "math-commons-education-translation/v1"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "language_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unesco",
        "walter_benson_2012",
        "separate_96_language_study"
      ],
      "properties": {
        "unesco": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "url"],
          "properties": {
            "claim": {"type": "string", "minLength": 1},
            "url": {"type": "string", "format": "uri"}
          }
        },
        "walter_benson_2012": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "doi",
            "chapter_pages",
            "evidence_pages",
            "table",
            "languages_over_ten_million",
            "used_in_education_over_ten_million",
            "not_used_in_education_over_ten_million",
            "population_used_in_education_over_ten_million",
            "population_not_used_in_education_over_ten_million",
            "population_used_in_education_all_bands",
            "population_not_used_in_education_all_bands",
            "population_without_first_language_access_percent_rounded",
            "calculation_note",
            "limitation"
          ],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "doi": {"const": "10.1017/CBO9780511979026.017"},
            "chapter_pages": {"const": "278-300"},
            "evidence_pages": {"const": "282-283"},
            "table": {"const": "14.2"},
            "languages_over_ten_million": {"const": 97},
            "used_in_education_over_ten_million": {"const": 52},
            "not_used_in_education_over_ten_million": {"const": 45},
            "population_used_in_education_over_ten_million": {"const": 3380555080},
            "population_not_used_in_education_over_ten_million": {"const": 1120220125},
            "population_used_in_education_all_bands": {"const": 3741110588},
            "population_not_used_in_education_all_bands": {"const": 2300263716},
            "population_without_first_language_access_percent_rounded": {"const": 38.075},
            "calculation_note": {"type": "string", "minLength": 1},
            "limitation": {"type": "string", "minLength": 1}
          }
        },
        "separate_96_language_study": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relationship", "note"],
          "properties": {
            "relationship": {"const": "unrelated_sample"},
            "note": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/material"}
    },
    "workflow": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/workflow_step"}
    },
    "starter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "url",
        "asset",
        "bytes",
        "sha256",
        "local_entry",
        "hosted_entry",
        "vendor_neutral"
      ],
      "properties": {
        "tag": {"const": "translate-v9-final"},
        "url": {"type": "string", "format": "uri"},
        "asset": {"const": "translation-starter-v9.zip"},
        "bytes": {"const": 17558},
        "sha256": {"$ref": "#/$defs/sha256"},
        "local_entry": {"const": "LOCAL.md"},
        "hosted_entry": {"const": "WEB.md"},
        "vendor_neutral": {"const": true}
      }
    },
    "research_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pages",
        "reader",
        "pdf",
        "pdf_bytes",
        "pdf_sha256",
        "version_doi",
        "concept_doi",
        "compute_example"
      ],
      "properties": {
        "title": {"const": "Allocating AI Translation Compute for Marginal Educational Access"},
        "pages": {"const": 87},
        "reader": {"type": "string", "format": "uri"},
        "pdf": {"type": "string", "format": "uri"},
        "pdf_bytes": {"const": 2089824},
        "pdf_sha256": {"$ref": "#/$defs/sha256"},
        "version_doi": {"const": "10.5281/zenodo.22103007"},
        "concept_doi": {"const": "10.5281/zenodo.21124403"},
        "compute_example": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_alpha_tokens",
            "low_gross_tokens",
            "base_gross_tokens",
            "high_gross_tokens",
            "limitation"
          ],
          "properties": {
            "source_alpha_tokens": {"const": 120083},
            "low_gross_tokens": {"const": 912737},
            "base_gross_tokens": {"const": 4073049},
            "high_gross_tokens": {"const": 18664571},
            "limitation": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "indonesian_program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "observed",
        "source_commit",
        "hub",
        "repository",
        "raw_catalog",
        "raw_catalog_bytes",
        "raw_catalog_sha256",
        "role_count",
        "complete_public_role_count",
        "complete_public_edition_count",
        "active_or_partial_role_count",
        "shared_complete_public_editions",
        "count_note",
        "freshness_note",
        "stale_detail_source_project_ids",
        "works"
      ],
      "properties": {
        "title": {"const": "Program Matematika Indonesia"},
        "observed": {"type": "string", "format": "date"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "hub": {"type": "string", "format": "uri"},
        "repository": {"type": "string", "format": "uri"},
        "raw_catalog": {"type": "string", "format": "uri"},
        "raw_catalog_bytes": {"type": "integer", "minimum": 1},
        "raw_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "role_count": {"const": 40},
        "complete_public_role_count": {"const": 21},
        "complete_public_edition_count": {"const": 20},
        "active_or_partial_role_count": {"const": 19},
        "shared_complete_public_editions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/shared_edition"}
        },
        "count_note": {"type": "string", "minLength": 1},
        "freshness_note": {"type": "string", "minLength": 1},
        "stale_detail_source_project_ids": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-D][0-9]{2,3}$"}
        },
        "works": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "items": {"$ref": "#/$defs/work"}
        }
      }
    },
    "highlighted_example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_language",
        "target_language",
        "source_url",
        "source_url_2012",
        "source_terms",
        "source_lectures",
        "source_worksheets",
        "edition_repository",
        "edition_doi",
        "volume_state",
        "larger_bridge_state",
        "note"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "source_language": {"const": "German"},
        "target_language": {"const": "Indonesian"},
        "source_url": {"type": "string", "format": "uri"},
        "source_url_2012": {"type": "string", "format": "uri"},
        "source_terms": {"type": "string", "minLength": 1},
        "source_lectures": {"const": 30},
        "source_worksheets": {"const": 30},
        "edition_repository": {"type": "string", "format": "uri"},
        "edition_doi": {"type": "string", "pattern": "^10\\.5281/zenodo\\.[0-9]+$"},
        "volume_state": {"const": "complete_public"},
        "larger_bridge_state": {"const": "active_or_partial"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "rule"],
      "properties": {
        "id": {
          "enum": [
            "open_license",
            "share_alike",
            "noncommercial_adaptable",
            "mixed_components"
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "workflow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "action"],
      "properties": {
        "step": {"type": "integer", "minimum": 1, "maximum": 6},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "shared_edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "roles"],
      "properties": {
        "edition": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"}
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_project_id",
        "topic",
        "title",
        "indonesian_title",
        "source",
        "state"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"},
        "source_project_id": {"type": "string", "pattern": "^[A-D][0-9]{2,3}$"},
        "topic": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "indonesian_title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "state": {"enum": ["complete_public", "active_or_partial"]}
      }
    }
  }
}
