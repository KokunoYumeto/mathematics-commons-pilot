{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-pilot/blob/main/schemas/portal-catalog.schema.json",
  "title": "Mathematics Commons portal catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "repository", "sections"],
  "properties": {
    "schema": {
      "enum": [
        "math-commons-portal-catalog/v1",
        "math-commons-portal-catalog/v2"
      ]
    },
    "updated": {"type": "string", "format": "date"},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://.+$"},
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema": {"const": "math-commons-portal-catalog/v1"},
        "sections": {"items": {"$ref": "#/$defs/legacySection"}}
      }
    },
    {
      "properties": {
        "schema": {"const": "math-commons-portal-catalog/v2"},
        "sections": {"items": {"$ref": "#/$defs/currentSection"}}
      }
    }
  ],
  "$defs": {
    "nullablePath": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+[.]zip$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
      }
    },
    "legacyPublishedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "url", "asset_count", "asset_bytes", "asset_catalog", "readback", "assets"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://.+$"},
        "asset_count": {"type": "integer", "minimum": 1},
        "asset_bytes": {"type": "integer", "minimum": 1},
        "asset_catalog": {"$ref": "#/$defs/nullablePath"},
        "readback": {"type": "string", "minLength": 1},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "currentPublishedRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "url", "target_commit", "target_tree", "asset_count", "asset_bytes", "asset_catalog", "readback", "assets"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://.+$"},
        "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "target_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "asset_count": {"type": "integer", "minimum": 1},
        "asset_bytes": {"type": "integer", "minimum": 1},
        "runnable_asset_count": {"type": "integer", "minimum": 1},
        "runnable_asset_bytes": {"type": "integer", "minimum": 1},
        "asset_catalog": {"$ref": "#/$defs/nullablePath"},
        "admission_receipt": {"$ref": "#/$defs/nullablePath"},
        "readback": {"type": "string", "minLength": 1},
        "workflow_state": {"enum": ["runnable_workflow", "source_bound_packet"]},
        "workflow_note": {"type": "string", "minLength": 1},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "pendingRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "url", "asset_count", "asset_bytes", "asset_catalog", "readback", "assets"],
      "properties": {
        "tag": {"type": "null"},
        "url": {"type": "null"},
        "asset_count": {"const": 0},
        "asset_bytes": {"const": 0},
        "asset_catalog": {"type": "null"},
        "readback": {"type": "null"},
        "assets": {"type": "array", "maxItems": 0}
      }
    },
    "legacySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "docs", "catalog", "summary", "release", "limitations"],
      "properties": {
        "id": {"enum": ["transcription", "translation", "open-problems"]},
        "title": {"type": "string", "minLength": 1},
        "state": {"enum": ["runnable", "starter_available", "source_recovery_required"]},
        "docs": {"type": "string", "pattern": "^docs/[A-Za-z0-9_.-]+\\.md$"},
        "catalog": {"$ref": "#/$defs/nullablePath"},
        "summary": {"type": "string", "minLength": 1},
        "release": {
          "oneOf": [
            {"$ref": "#/$defs/legacyPublishedRelease"},
            {"$ref": "#/$defs/pendingRelease"}
          ]
        },
        "expected_asset": {"$ref": "#/$defs/asset"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "oneOf": [
        {
          "not": {"required": ["expected_asset"]},
          "properties": {
            "id": {"const": "transcription"},
            "state": {"const": "runnable"},
            "release": {"$ref": "#/$defs/legacyPublishedRelease"}
          }
        },
        {
          "not": {"required": ["expected_asset"]},
          "properties": {
            "id": {"const": "translation"},
            "state": {"const": "starter_available"},
            "release": {"$ref": "#/$defs/legacyPublishedRelease"}
          }
        },
        {
          "required": ["expected_asset"],
          "properties": {
            "id": {"const": "open-problems"},
            "state": {"const": "source_recovery_required"},
            "catalog": {"type": "null"},
            "release": {"$ref": "#/$defs/pendingRelease"}
          }
        }
      ]
    },
    "currentSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "state", "docs", "catalog", "summary", "release", "limitations"],
      "properties": {
        "id": {"enum": ["transcription", "translation", "open-problems"]},
        "title": {"type": "string", "minLength": 1},
        "state": {"enum": ["runnable", "source_recovery_required"]},
        "docs": {"type": "string", "pattern": "^docs/[A-Za-z0-9_.-]+\\.md$"},
        "catalog": {"$ref": "#/$defs/nullablePath"},
        "summary": {"type": "string", "minLength": 1},
        "release": {
          "oneOf": [
            {"$ref": "#/$defs/currentPublishedRelease"},
            {"$ref": "#/$defs/pendingRelease"}
          ]
        },
        "starter": {"$ref": "#/$defs/currentPublishedRelease"},
        "expected_asset": {"$ref": "#/$defs/asset"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "oneOf": [
        {
          "not": {"anyOf": [{"required": ["expected_asset"]}, {"required": ["starter"]}]},
          "properties": {
            "id": {"const": "transcription"},
            "state": {"const": "runnable"},
            "release": {
              "allOf": [
                {"$ref": "#/$defs/currentPublishedRelease"},
                {"required": ["runnable_asset_count", "runnable_asset_bytes"]}
              ]
            }
          }
        },
        {
          "required": ["starter"],
          "not": {"required": ["expected_asset"]},
          "properties": {
            "id": {"const": "translation"},
            "state": {"const": "runnable"},
            "release": {"$ref": "#/$defs/currentPublishedRelease"},
            "starter": {"$ref": "#/$defs/currentPublishedRelease"}
          }
        },
        {
          "required": ["expected_asset"],
          "not": {"required": ["starter"]},
          "properties": {
            "id": {"const": "open-problems"},
            "state": {"const": "source_recovery_required"},
            "catalog": {"type": "null"},
            "release": {"$ref": "#/$defs/pendingRelease"}
          }
        }
      ]
    }
  }
}
