{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-pilot/blob/main/schemas/translation-catalog.schema.json",
  "title": "Mathematics Commons translation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated", "scope", "language_priority", "evidence", "page_accounting", "entries", "exclusions"],
  "properties": {
    "schema": {"const": "math-commons-translation-catalog/v3"},
    "updated": {"type": "string", "format": "date"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_exhaustive", "other_open_works_welcome", "description", "coverage_rule", "legacy_id_rule"],
      "properties": {
        "non_exhaustive": {"const": true},
        "other_open_works_welcome": {"const": true},
        "description": {"type": "string", "minLength": 1},
        "coverage_rule": {"type": "string", "minLength": 1},
        "legacy_id_rule": {"type": "string", "minLength": 1}
      }
    },
    "language_priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any_language_welcome", "priority_rule", "education_access_source", "uis_96_language_study", "unesco_fixed_translation_priority_list", "note"],
      "properties": {
        "any_language_welcome": {"const": true},
        "priority_rule": {"type": "string", "minLength": 1},
        "education_access_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "published", "url", "reported_facts"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "published": {"type": "string", "format": "date"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://www\\.unesco\\.org/.*$"},
            "reported_facts": {"$ref": "#/$defs/stringArray"}
          }
        },
        "uis_96_language_study": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "publisher", "published", "url", "page", "cited_study", "country_count", "alphabetic_language_count", "reported_facts", "language_labels", "label_note", "translation_use"],
          "properties": {
            "title": {"const": "Benchmarking by Language Groups Framework"},
            "publisher": {"const": "UNESCO Institute for Statistics"},
            "published": {"type": "string", "format": "date"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://www\\.uis\\.unesco\\.org/.*$"},
            "page": {"const": 22},
            "cited_study": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "doi_url", "supplement_url", "language_table"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "doi_url": {"const": "https://doi.org/10.1038/s41562-024-02028-x"},
                "supplement_url": {"type": "string", "format": "uri", "pattern": "^https://static-content\\.springer\\.com/.*$"},
                "language_table": {"const": "Table S1"}
              }
            },
            "country_count": {"const": 48},
            "alphabetic_language_count": {"const": 96},
            "reported_facts": {"$ref": "#/$defs/stringArray"},
            "language_labels": {
              "type": "array",
              "minItems": 96,
              "maxItems": 96,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "label_note": {"type": "string", "minLength": 1},
            "translation_use": {"type": "string", "minLength": 1}
          }
        },
        "unesco_fixed_translation_priority_list": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "public_evidence_included", "consumer_rule", "sources"],
      "properties": {
        "note": {"type": "string", "minLength": 1},
        "public_evidence_included": {"const": false},
        "consumer_rule": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "sha256", "role", "availability"],
            "properties": {
              "file": {"type": "string", "pattern": "^[^/\\\\]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "role": {"type": "string", "minLength": 1},
              "availability": {"const": "not_public_in_this_repository"}
            }
          }
        }
      }
    },
    "page_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_selected_pages", "aggregate_teaching_package_pages", "aggregate_reference_pages", "fact", "individual_page_policy"],
      "properties": {
        "aggregate_selected_pages": {"type": ["integer", "null"], "minimum": 0},
        "aggregate_teaching_package_pages": {"type": ["integer", "null"], "minimum": 0},
        "aggregate_reference_pages": {"type": ["integer", "null"], "minimum": 0},
        "fact": {"type": "string", "minLength": 1},
        "individual_page_policy": {"type": "string", "minLength": 1}
      }
    },
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "knownEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_tag", "language_name", "state", "scope_note", "evidence_status"],
      "properties": {
        "language_tag": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
        "language_name": {"type": "string", "minLength": 1},
        "state": {"enum": ["reported_active", "reported_complete", "reported_planned", "verified_active", "verified_complete"]},
        "scope_note": {"type": "string", "minLength": 1},
        "evidence_status": {"enum": ["non_public_coordination_snapshot", "public_identity_verified"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "legacy_id", "title", "authors", "authors_note", "catalog_role", "reported_status", "known_editions", "coverage_note", "curricular_role", "pages", "page_note", "source_url", "source_repo", "source_commit", "source_tree", "license", "derivative_allowed", "source_evidence_status", "component_caveats", "source_format", "preflight_needed", "translation_readiness", "why_listed", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "legacy_id": {"type": "string", "pattern": "^(?:R|O)[0-9]{3}[a-z]?$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stringArray"}]},
        "authors_note": {"$ref": "#/$defs/nullableString"},
        "catalog_role": {"enum": ["adaptation", "component", "composite", "course", "infrastructure", "reference", "series", "source_project", "work"]},
        "reported_status": {"type": "string", "minLength": 1},
        "known_editions": {"type": "array", "items": {"$ref": "#/$defs/knownEdition"}},
        "coverage_note": {"type": "string", "minLength": 1},
        "curricular_role": {"$ref": "#/$defs/nullableString"},
        "pages": {"type": ["integer", "null"], "minimum": 1},
        "page_note": {"type": "string", "minLength": 1},
        "source_url": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https://.+$"}]},
        "source_repo": {"$ref": "#/$defs/nullableString"},
        "source_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "source_tree": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "license": {"$ref": "#/$defs/nullableString"},
        "derivative_allowed": {"type": ["boolean", "null"]},
        "source_evidence_status": {"enum": ["independently_verified_public_boundary", "reported_not_independently_replayed"]},
        "component_caveats": {"$ref": "#/$defs/stringArray"},
        "source_format": {"type": "string", "minLength": 1},
        "preflight_needed": {"type": "string", "minLength": 1},
        "translation_readiness": {"enum": ["preflight_required", "not_standalone"]},
        "why_listed": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "reason", "license", "derivative_allowed", "catalog_disposition", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^X-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stringArray"}]},
        "reason": {"type": "string", "minLength": 1},
        "license": {"$ref": "#/$defs/nullableString"},
        "derivative_allowed": {"type": ["boolean", "null"]},
        "catalog_disposition": {"enum": ["rejected", "reference_only", "rejected_until_verified"]},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
