{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-pilot/blob/main/schemas/translation-catalog.schema.json",
  "title": "Mathematics Commons translation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "scope", "language_priority", "distribution_legend", "separate_archive", "evidence", "page_accounting", "topics", "works", "resources", "source_editions", "translation_editions", "jobs", "exclusions"],
  "properties": {
    "schema": {"const": "math-commons-translation-catalog/v8"},
    "updated_at": {"type": "string", "format": "date-time"},
    "scope": {"$ref": "#/$defs/scope"},
    "language_priority": {"$ref": "#/$defs/languagePriority"},
    "distribution_legend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_license", "noncommercial_only", "mixed_components", "terms_unclassified", "no_derivatives", "reference_only"],
      "properties": {
        "open_license": {"type": "string", "minLength": 1},
        "noncommercial_only": {"type": "string", "minLength": 1},
        "mixed_components": {"type": "string", "minLength": 1},
        "terms_unclassified": {"type": "string", "minLength": 1},
        "no_derivatives": {"type": "string", "minLength": 1},
        "reference_only": {"type": "string", "minLength": 1}
      }
    },
    "separate_archive": {"$ref": "#/$defs/separateArchive"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "page_accounting": {"$ref": "#/$defs/pageAccounting"},
    "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topic"}},
    "works": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work"}},
    "resources": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
    "source_editions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceEdition"}},
    "translation_editions": {"type": "array", "items": {"$ref": "#/$defs/translationEdition"}},
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "hex40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "slugArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_exhaustive", "other_open_works_welcome", "description", "coverage_rule"],
      "properties": {
        "non_exhaustive": {"const": true},
        "other_open_works_welcome": {"const": true},
        "description": {"type": "string", "minLength": 1},
        "coverage_rule": {"type": "string", "minLength": 1}
      }
    },
    "languagePriority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any_language_welcome", "priority_rule", "education_access_source", "uis_96_language_study", "unesco_fixed_translation_priority_list", "note"],
      "properties": {
        "any_language_welcome": {"const": true},
        "priority_rule": {"type": "string", "minLength": 1},
        "education_access_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "published", "url", "reported_facts"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "published": {"type": "string", "format": "date"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://.*$"},
            "reported_facts": {"$ref": "#/$defs/stringArray"}
          }
        },
        "uis_96_language_study": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "publisher", "published", "url", "page", "cited_study", "country_count", "alphabetic_language_count", "reported_facts", "language_labels", "label_note", "translation_use"],
          "properties": {
            "title": {"const": "Benchmarking by Language Groups Framework"},
            "publisher": {"const": "UNESCO Institute for Statistics"},
            "published": {"type": "string", "format": "date"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://.*$"},
            "page": {"const": 22},
            "cited_study": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "doi_url", "supplement_url", "language_table"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "doi_url": {"const": "https://doi.org/10.1038/s41562-024-02028-x"},
                "supplement_url": {"type": "string", "format": "uri", "pattern": "^https://.*$"},
                "language_table": {"const": "Table S1"}
              }
            },
            "country_count": {"const": 48},
            "alphabetic_language_count": {"const": 96},
            "reported_facts": {"$ref": "#/$defs/stringArray"},
            "language_labels": {"type": "array", "minItems": 96, "maxItems": 96, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "label_note": {"type": "string", "minLength": 1},
            "translation_use": {"type": "string", "minLength": 1}
          }
        },
        "unesco_fixed_translation_priority_list": {"const": false},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "separateArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "path", "bytes", "sha256", "rows", "state", "warning"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://.*$"},
        "commit": {"$ref": "#/$defs/hex40"},
        "tree": {"$ref": "#/$defs/hex40"},
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "minLength": 1},
        "warning": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "availability"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "availability": {"const": "not_public"}
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "recorded_at", "artifact", "note"],
          "properties": {
            "id": {"$ref": "#/$defs/slug"},
            "kind": {"const": "historical_nonpublic_snapshot"},
            "recorded_at": {"type": "string", "format": "date-time"},
            "artifact": {"$ref": "#/$defs/artifact"},
            "note": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "observed_at", "url", "repository", "commit", "tree", "note"],
          "properties": {
            "id": {"$ref": "#/$defs/slug"},
            "kind": {"const": "public_git_replay"},
            "observed_at": {"type": "string", "format": "date-time"},
            "url": {"type": "string", "format": "uri", "pattern": "^https://.*$"},
            "repository": {"type": "string", "format": "uri", "pattern": "^https://.*$"},
            "commit": {"$ref": "#/$defs/hex40"},
            "tree": {"$ref": "#/$defs/hex40"},
            "note": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "observed_at", "path", "bytes", "sha256", "note"],
          "properties": {
            "id": {"$ref": "#/$defs/slug"},
            "kind": {"const": "same_commit_receipt"},
            "observed_at": {"type": "string", "format": "date-time"},
            "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "note": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "pageAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate_pages", "rule"],
      "properties": {
        "aggregate_pages": {"type": ["integer", "null"], "minimum": 0},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "work_ids", "resource_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1},
        "work_ids": {"$ref": "#/$defs/slugArray"},
        "resource_ids": {"$ref": "#/$defs/slugArray"}
      }
    },
    "itemBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "creators", "creators_note", "topic_ids", "curricular_role", "pages", "page_note", "coverage_note", "why_listed", "source_edition_ids", "translation_edition_ids", "job_ids", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "kind": {"enum": ["work", "series", "course", "source_project", "adaptation", "component", "composite", "infrastructure", "reference"]},
        "title": {"type": "string", "minLength": 1},
        "creators": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stringArray"}]},
        "creators_note": {"$ref": "#/$defs/nullableString"},
        "topic_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "curricular_role": {"$ref": "#/$defs/nullableString"},
        "pages": {"type": ["integer", "null"], "minimum": 1},
        "page_note": {"type": "string", "minLength": 1},
        "coverage_note": {"type": "string", "minLength": 1},
        "why_listed": {"type": "string", "minLength": 1},
        "source_edition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "translation_edition_ids": {"$ref": "#/$defs/slugArray"},
        "job_ids": {"$ref": "#/$defs/slugArray"},
        "evidence_ids": {"$ref": "#/$defs/slugArray"}
      }
    },
    "work": {"$ref": "#/$defs/itemBase"},
    "resource": {"$ref": "#/$defs/itemBase"},
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "name", "locale", "script", "orthographic_standard"],
      "properties": {
        "tag": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"}]},
        "name": {"$ref": "#/$defs/nullableString"},
        "locale": {"$ref": "#/$defs/nullableString"},
        "script": {"$ref": "#/$defs/nullableString"},
        "orthographic_standard": {"$ref": "#/$defs/nullableString"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "basis", "evidence_ids"],
      "properties": {
        "state": {"enum": ["pass", "fail", "unknown"]},
        "basis": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/slugArray"}
      }
    },
    "evidenceChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_identity", "source_edition_identity", "immutable_source", "translation_permission", "component_rights", "editable_source", "baseline_build"],
      "properties": {
        "work_identity": {"$ref": "#/$defs/gate"},
        "source_edition_identity": {"$ref": "#/$defs/gate"},
        "immutable_source": {"$ref": "#/$defs/gate"},
        "translation_permission": {"$ref": "#/$defs/gate"},
        "component_rights": {"$ref": "#/$defs/gate"},
        "editable_source": {"$ref": "#/$defs/gate"},
        "baseline_build": {"$ref": "#/$defs/gate"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "work_license", "derivative_translation_allowed", "component_notices", "evidence_ids", "distribution_class", "distribution_note"],
      "properties": {
        "state": {"enum": ["verified_translation_allowed", "reported_unverified"]},
        "work_license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "scope"],
          "properties": {
            "name": {"$ref": "#/$defs/nullableString"},
            "url": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https://.*$"}]},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "derivative_translation_allowed": {"type": ["boolean", "null"]},
        "distribution_class": {
          "enum": [
            "open_license",
            "noncommercial_only",
            "mixed_components",
            "terms_unclassified",
            "no_derivatives",
            "reference_only"
          ]
        },
        "distribution_note": {"type": "string", "minLength": 1},
        "component_notices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "license"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_ids": {"$ref": "#/$defs/slugArray"}
      }
    },
    "sourceEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item_id", "item_type", "identity_state", "label", "source_language", "locator", "rights", "components", "evidence_checks", "readiness", "workflow_startability", "workflow_mode", "workflow_note", "next_action", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "item_id": {"$ref": "#/$defs/slug"},
        "item_type": {"enum": ["work", "resource"]},
        "identity_state": {"enum": ["frozen", "reported_locator", "unresolved"]},
        "label": {"type": "string", "minLength": 1},
        "source_language": {"$ref": "#/$defs/language"},
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "repository", "commit", "tree", "archive"],
          "properties": {
            "url": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https://.*$"}]},
            "repository": {"$ref": "#/$defs/nullableString"},
            "commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hex40"}]},
            "tree": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hex40"}]},
            "archive": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https://.*$"}]}
          }
        },
        "rights": {"$ref": "#/$defs/rights"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded", "receipt"],
          "properties": {
            "included": {"$ref": "#/$defs/nullableString"},
            "excluded": {"$ref": "#/$defs/nullableString"},
            "receipt": {"$ref": "#/$defs/nullableString"}
          }
        },
        "evidence_checks": {"$ref": "#/$defs/evidenceChecks"},
        "readiness": {"enum": ["identity_unresolved", "listed", "reference_only", "packet_prepared", "runnable"]},
        "workflow_startability": {"enum": ["starter_available", "source_bound_packet", "reference_only"]},
        "workflow_mode": {"enum": ["generic_starter", "source_bound_packet", "reference_only"]},
        "workflow_note": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/slugArray"}
      }
    },
    "translationEdition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "work_id", "source_edition_id", "identity_state", "target_language", "progress_state", "review_state", "scope_note", "owner", "overlap", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "work_id": {"$ref": "#/$defs/slug"},
        "source_edition_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/slug"}]},
        "identity_state": {"enum": ["unverified_report", "public_repository_verified", "public_edition_verified", "frozen_complete"]},
        "target_language": {"$ref": "#/$defs/language"},
        "progress_state": {"enum": ["repository_available", "public_reader_available_scope_unassessed", "historical_report_active_at_recording", "historical_report_complete_at_recording", "historical_report_planned_at_recording", "verified_active", "verified_complete", "inactive"]},
        "review_state": {"enum": ["unknown", "not_independently_assessed", "in_review", "passed"]},
        "scope_note": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/nullableString"},
        "overlap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "related_edition_ids", "purpose"],
          "properties": {
            "mode": {"enum": ["unknown", "none_known", "declared_parallel", "supersedes", "superseded"]},
            "related_edition_ids": {"$ref": "#/$defs/slugArray"},
            "purpose": {"$ref": "#/$defs/nullableString"}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_at", "recorded_at", "public_url", "commit", "tree", "evidence_ids"],
          "properties": {
            "status": {"enum": ["non_public_historical_report", "public_repository_identity_verified", "public_bytes_verified"]},
            "observed_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
            "recorded_at": {"type": "string", "format": "date-time"},
            "public_url": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https://.*$"}]},
            "commit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hex40"}]},
            "tree": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hex40"}]},
            "doi": {"type": "string", "pattern": "^10[.]6084/m9[.]figshare[.][A-Za-z0-9.]+$"},
            "file": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+[.]pdf$"},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "download_url": {"type": "string", "format": "uri", "pattern": "^https://ndownloader[.]figshare[.]com/files/[0-9]+$"},
            "collection_doi": {"const": "10.6084/m9.figshare.c.8668413.v25"},
            "receipt_path": {"const": "catalog/receipts/id-readers.json"},
            "evidence_ids": {"$ref": "#/$defs/slugArray"}
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256", "url"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.zip$"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://.*$"}
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "observed_date", "assets"],
      "properties": {
        "receipt": {"type": "string", "pattern": "^catalog/[a-z0-9.-]+\\.json$"},
        "observed_date": {"type": "string", "format": "date"},
        "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "work_id", "source_edition_id", "title", "target_mode", "state", "release_tag", "release_url", "assets", "asset_manifest", "source_receipt", "public_readback", "start_files", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "work_id": {"$ref": "#/$defs/slug"},
        "source_edition_id": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1},
        "target_mode": {"enum": ["contributor_selects", "fixed"]},
        "state": {"enum": ["prepared_not_published", "runnable", "retired"]},
        "release_tag": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "release_url": {"oneOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https://.*$"}]},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
        "asset_manifest": {"type": "string", "pattern": "^catalog/assets/[a-z0-9.-]+\\.json$"},
        "source_receipt": {"type": "string", "pattern": "^catalog/receipts/[a-z0-9.-]+\\.json$"},
        "public_readback": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/readback"}]},
        "start_files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local", "web"],
          "properties": {
            "local": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.md$"},
            "web": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.md$"}
          }
        },
        "evidence_ids": {"$ref": "#/$defs/slugArray"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "reason", "license", "derivative_allowed", "catalog_disposition", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^X-[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stringArray"}]},
        "reason": {"type": "string", "minLength": 1},
        "license": {"$ref": "#/$defs/nullableString"},
        "derivative_allowed": {"type": ["boolean", "null"]},
        "catalog_disposition": {"enum": ["rejected", "reference_only", "rejected_until_verified"]},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
