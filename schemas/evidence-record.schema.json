{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KokunoYumeto/mathematics-commons-pilot/main/schemas/evidence-record.schema.json",
  "title": "Mathematics Commons Evidence Artifact Record",
  "description": "A versioned manifest for one submitted evidence artifact and its reproducibility, rights and formalization state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "record_version",
    "artifact_id",
    "packet_ref",
    "run_ref",
    "status",
    "evidence_kind",
    "created_at",
    "artifact_path",
    "media_type",
    "byte_size",
    "hashes",
    "source_record_ids",
    "claims_supported",
    "method_summary",
    "dependency_artifacts",
    "checks",
    "reproducibility",
    "formalization",
    "submission_boundary",
    "submission_rights",
    "limitations"
  ],
  "properties": {
    "record_type": {
      "const": "evidence_record"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "record_version": {
      "$ref": "#/$defs/semver"
    },
    "artifact_id": {
      "$ref": "#/$defs/stable_id"
    },
    "packet_ref": {
      "$ref": "#/$defs/packet_reference"
    },
    "run_ref": {
      "$ref": "#/$defs/run_reference"
    },
    "status": {
      "enum": [
        "candidate",
        "complete",
        "invalid",
        "under_review",
        "challenged",
        "superseded",
        "withdrawn"
      ]
    },
    "evidence_kind": {
      "enum": [
        "bibliography",
        "source_notes",
        "mathematical_argument",
        "counterexample",
        "computation",
        "certificate",
        "formalization",
        "correspondence_map",
        "transcription",
        "translation",
        "exposition",
        "test_receipt",
        "metadata",
        "other"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "archive_uri": {
      "type": "string",
      "format": "uri"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "hashes": {
      "$ref": "#/$defs/hashes"
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stable_id"
      }
    },
    "claims_supported": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_version",
          "relationship"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/stable_id"
          },
          "claim_version": {
            "$ref": "#/$defs/semver"
          },
          "relationship": {
            "enum": [
              "supports",
              "refutes",
              "qualifies",
              "context_only"
            ]
          }
        }
      }
    },
    "method_summary": {
      "type": "string",
      "minLength": 1
    },
    "dependency_artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/artifact_reference"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "method",
          "status",
          "receipt_artifact_ids",
          "notes"
        ],
        "properties": {
          "check_id": {
            "$ref": "#/$defs/stable_id"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "inconclusive"
            ]
          },
          "receipt_artifact_ids": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "instructions",
        "clean_environment_status",
        "independently_reproduced",
        "review_binding"
      ],
      "properties": {
        "level": {
          "enum": [
            "not_applicable",
            "instructions_only",
            "replayable",
            "exactly_replayed",
            "independently_reproduced",
            "certified"
          ]
        },
        "instructions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clean_environment_status": {
          "enum": [
            "not_applicable",
            "not_tested",
            "passed",
            "failed"
          ]
        },
        "independently_reproduced": {
          "type": "boolean"
        },
        "review_binding": {
          "description": "Reviews are bound by a packet transition that contains exact full-record references to both this evidence version and the completed review, avoiding an evidence-review hash cycle.",
          "const": "exact_transition_refs"
        }
      }
    },
    "formalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_role",
        "formal_status",
        "statement_correspondence_status",
        "formal_systems",
        "trust_base",
        "placeholder_status",
        "formal_acceptance_establishes_statement_correspondence"
      ],
      "properties": {
        "artifact_role": {
          "enum": [
            "not_formal",
            "formalization",
            "correspondence_map"
          ]
        },
        "formal_status": {
          "enum": [
            "not_applicable",
            "candidate",
            "partial",
            "compiles",
            "no_placeholders",
            "failed"
          ]
        },
        "statement_correspondence_status": {
          "enum": [
            "not_applicable",
            "not_reviewed",
            "pending",
            "passed",
            "failed"
          ]
        },
        "formal_systems": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trust_base": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "placeholder_status": {
          "enum": [
            "not_applicable",
            "unknown",
            "present",
            "absent"
          ]
        },
        "formal_acceptance_establishes_statement_correspondence": {
          "const": false
        }
      },
      "oneOf": [
        {
          "properties": {
            "artifact_role": {
              "const": "not_formal"
            },
            "formal_status": {
              "const": "not_applicable"
            },
            "statement_correspondence_status": {
              "const": "not_applicable"
            },
            "placeholder_status": {
              "const": "not_applicable"
            }
          }
        },
        {
          "properties": {
            "artifact_role": {
              "const": "formalization"
            },
            "formal_status": {
              "enum": [
                "candidate",
                "partial",
                "compiles",
                "no_placeholders",
                "failed"
              ]
            },
            "statement_correspondence_status": {
              "enum": [
                "not_reviewed",
                "pending",
                "passed",
                "failed"
              ]
            },
            "placeholder_status": {
              "enum": [
                "unknown",
                "present",
                "absent"
              ]
            }
          }
        },
        {
          "properties": {
            "artifact_role": {
              "const": "correspondence_map"
            },
            "formal_status": {
              "const": "not_applicable"
            },
            "statement_correspondence_status": {
              "enum": [
                "not_reviewed",
                "pending",
                "passed",
                "failed"
              ]
            },
            "placeholder_status": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "submission_boundary": {
      "$ref": "#/$defs/submission_boundary"
    },
    "submission_rights": {
      "$ref": "#/$defs/submission_rights"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hash"
      }
    },
    "packet_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "run_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "record_version",
        "hashes"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "record_version": {
          "$ref": "#/$defs/semver"
        },
        "hashes": {
          "$ref": "#/$defs/hashes"
        }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "none_identified",
            "known",
            "not_assessed"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "submission_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_by_default",
        "schema_fields_are_public_allowlist",
        "allowlisted_artifact_ids",
        "excluded_from_submission_by_default",
        "raw_interaction_records_required",
        "redaction_status",
        "publication_preview_status",
        "retention_rule"
      ],
      "properties": {
        "private_by_default": {
          "const": true
        },
        "schema_fields_are_public_allowlist": {
          "const": true
        },
        "allowlisted_artifact_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "excluded_from_submission_by_default": {
          "$ref": "#/$defs/private_exclusions"
        },
        "raw_interaction_records_required": {
          "const": false
        },
        "redaction_status": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "publication_preview_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "retention_rule": {
          "enum": [
            "approved_submission_only",
            "metadata_only",
            "time_limited"
          ]
        }
      }
    },
    "private_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_transcript",
        "prompt_history",
        "chain_of_thought",
        "private_notes",
        "unpublished_communications",
        "personal_context",
        "credentials",
        "unrelated_local_files"
      ],
      "properties": {
        "raw_transcript": {
          "const": true
        },
        "prompt_history": {
          "const": true
        },
        "chain_of_thought": {
          "const": true
        },
        "private_notes": {
          "const": true
        },
        "unpublished_communications": {
          "const": true
        },
        "personal_context": {
          "const": true
        },
        "credentials": {
          "const": true
        },
        "unrelated_local_files": {
          "const": true
        }
      }
    },
    "submission_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commons_originated_record",
        "dedication",
        "dedication_scope",
        "submitted_component_ids",
        "third_party_rights_preserved",
        "third_party_source_ids",
        "redistribution_status"
      ],
      "properties": {
        "commons_originated_record": {
          "const": true
        },
        "dedication": {
          "const": "CC0-1.0"
        },
        "dedication_scope": {
          "const": "intentionally_submitted_commons_components_only"
        },
        "submitted_component_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "third_party_rights_preserved": {
          "const": true
        },
        "third_party_source_ids": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "redistribution_status": {
          "enum": [
            "permitted",
            "restricted",
            "unresolved",
            "metadata_only"
          ]
        }
      }
    }
  }
}
