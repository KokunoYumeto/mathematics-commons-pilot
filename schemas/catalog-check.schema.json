{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-pilot/raw/main/schemas/catalog-check.schema.json",
  "title": "Mathematics Commons catalog validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "inputs",
    "asset_manifests",
    "jobs",
    "release_assets",
    "release_asset_bytes",
    "packet_source_files",
    "packet_source_bytes",
    "zip_member_files_replayed",
    "nested_authorities_replayed",
    "asset_mode",
    "translation",
    "formalization_entries",
    "portal_sections",
    "public_readback",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "math-commons-catalog-check/v3"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_meta",
        "jobs",
        "translations",
        "education",
        "translation_choices",
        "translation_source",
        "openlogic_source",
        "openlogic_job",
        "openlogic_build",
        "formalization",
        "portals",
        "readback",
        "readback_r2",
        "translate_readback",
        "openlogic_readback",
        "translate_v7_readback",
        "translate_v8_readback",
        "translate_v9_readback",
        "openlogic_asset_manifest",
        "translate_v7_asset_manifest",
        "translate_v8_asset_manifest",
        "translate_v9_asset_manifest",
        "global_receipt",
        "gordan2_receipt",
        "mikami_receipt",
        "r2_admission_receipt",
        "no_failure_hardening_receipt",
        "openlogic_receipt",
        "id_readers_receipt",
        "job_meta_schema",
        "job_schema",
        "translation_schema",
        "translation_choices_schema",
        "translation_source_schema",
        "translation_build_schema",
        "education_schema",
        "formalization_schema",
        "portal_schema",
        "asset_schema",
        "readback_schema",
        "portal_readback_schema",
        "check_schema",
        "schema_validator",
        "packer",
        "builder",
        "admission_builder",
        "manifest_repair",
        "readback_tool",
        "openlogic_builder",
        "openlogic_auditor",
        "translation_builder",
        "translation_migrator",
        "translation_reader_updater",
        "portal_readback_tool",
        "validator"
      ],
      "properties": {
        "job_meta": {
          "$ref": "#/$defs/identity"
        },
        "jobs": {
          "$ref": "#/$defs/identity"
        },
        "translations": {
          "$ref": "#/$defs/identity"
        },
        "education": {
          "$ref": "#/$defs/identity"
        },
        "translation_choices": {
          "$ref": "#/$defs/identity"
        },
        "translation_source": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_source": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_job": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_build": {
          "$ref": "#/$defs/identity"
        },
        "formalization": {
          "$ref": "#/$defs/identity"
        },
        "portals": {
          "$ref": "#/$defs/identity"
        },
        "readback": {
          "$ref": "#/$defs/identity"
        },
        "readback_r2": {
          "$ref": "#/$defs/identity"
        },
        "translate_readback": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_readback": {
          "$ref": "#/$defs/identity"
        },
        "translate_v7_readback": {
          "oneOf": [
            {"$ref": "#/$defs/identity"},
            {"type": "null"}
          ]
        },
        "translate_v8_readback": {
          "oneOf": [
            {"$ref": "#/$defs/identity"},
            {"type": "null"}
          ]
        },
        "translate_v9_readback": {
          "oneOf": [
            {"$ref": "#/$defs/identity"},
            {"type": "null"}
          ]
        },
        "openlogic_asset_manifest": {
          "$ref": "#/$defs/identity"
        },
        "translate_v7_asset_manifest": {
          "$ref": "#/$defs/identity"
        },
        "translate_v8_asset_manifest": {
          "$ref": "#/$defs/identity"
        },
        "translate_v9_asset_manifest": {
          "$ref": "#/$defs/identity"
        },
        "global_receipt": {
          "$ref": "#/$defs/identity"
        },
        "gordan2_receipt": {
          "$ref": "#/$defs/identity"
        },
        "mikami_receipt": {
          "$ref": "#/$defs/identity"
        },
        "r2_admission_receipt": {
          "$ref": "#/$defs/identity"
        },
        "no_failure_hardening_receipt": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_receipt": {
          "$ref": "#/$defs/identity"
        },
        "id_readers_receipt": {
          "$ref": "#/$defs/identity"
        },
        "job_meta_schema": {
          "$ref": "#/$defs/identity"
        },
        "job_schema": {
          "$ref": "#/$defs/identity"
        },
        "translation_schema": {
          "$ref": "#/$defs/identity"
        },
        "translation_choices_schema": {
          "$ref": "#/$defs/identity"
        },
        "translation_source_schema": {
          "$ref": "#/$defs/identity"
        },
        "translation_build_schema": {
          "$ref": "#/$defs/identity"
        },
        "education_schema": {
          "$ref": "#/$defs/identity"
        },
        "formalization_schema": {
          "$ref": "#/$defs/identity"
        },
        "portal_schema": {
          "$ref": "#/$defs/identity"
        },
        "asset_schema": {
          "$ref": "#/$defs/identity"
        },
        "readback_schema": {
          "$ref": "#/$defs/identity"
        },
        "portal_readback_schema": {
          "$ref": "#/$defs/identity"
        },
        "check_schema": {
          "$ref": "#/$defs/identity"
        },
        "schema_validator": {
          "$ref": "#/$defs/identity"
        },
        "packer": {
          "$ref": "#/$defs/identity"
        },
        "builder": {
          "$ref": "#/$defs/identity"
        },
        "admission_builder": {
          "$ref": "#/$defs/identity"
        },
        "manifest_repair": {
          "$ref": "#/$defs/identity"
        },
        "readback_tool": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_builder": {
          "$ref": "#/$defs/identity"
        },
        "openlogic_auditor": {
          "$ref": "#/$defs/identity"
        },
        "translation_builder": {
          "$ref": "#/$defs/identity"
        },
        "translation_migrator": {
          "$ref": "#/$defs/identity"
        },
        "translation_reader_updater": {
          "$ref": "#/$defs/identity"
        },
        "portal_readback_tool": {
          "$ref": "#/$defs/identity"
        },
        "validator": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "asset_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes",
        "canonical_stream_bytes",
        "tree_sha256"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_stream_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "jobs": {
      "type": "integer",
      "minimum": 0
    },
    "release_assets": {
      "type": "integer",
      "minimum": 0
    },
    "release_asset_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "packet_source_files": {
      "type": "integer",
      "minimum": 0
    },
    "packet_source_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "zip_member_files_replayed": {
      "type": "integer",
      "minimum": 0
    },
    "nested_authorities_replayed": {
      "type": "integer",
      "minimum": 0
    },
    "asset_mode": {
      "enum": [
        "local_zip_replay",
        "admission_receipt_plus_public_readback",
        "catalog_only"
      ]
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "works", "resources", "source_editions", "translation_editions", "jobs", "workflow_startable_works", "packaged_runnable_jobs", "runnable_jobs", "runnable_jobs_scope", "public_release_assets", "public_release_bytes"],
      "properties": {
        "topics": {"type": "integer", "minimum": 0},
        "works": {"type": "integer", "minimum": 0},
        "resources": {"type": "integer", "minimum": 0},
        "source_editions": {"type": "integer", "minimum": 0},
        "translation_editions": {"type": "integer", "minimum": 0},
        "jobs": {"type": "integer", "minimum": 0},
        "workflow_startable_works": {"type": "integer", "minimum": 0},
        "packaged_runnable_jobs": {"type": "integer", "minimum": 0},
        "runnable_jobs": {"type": "integer", "minimum": 0},
        "runnable_jobs_scope": {"const": "self_contained_public_packets_only"},
        "public_release_assets": {"type": "integer", "minimum": 0},
        "public_release_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "formalization_entries": {
      "type": "integer",
      "minimum": 0
    },
    "portal_sections": {
      "type": "integer",
      "minimum": 0
    },
    "public_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "subject_commit",
        "release_tag",
        "release_id",
        "transport",
        "observed_date",
        "release_assets",
        "release_asset_bytes",
        "raw_files",
        "mismatches",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL"]
        },
        "subject_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^jobs-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]+$"
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "transport": {
          "const": "anonymous_https"
        },
        "observed_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "release_assets": {
          "type": "integer",
          "minimum": 0
        },
        "release_asset_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_files": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": {"const": "PASS"},
        "errors": {"maxItems": 0}
      }
    },
    {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": {"const": "FAIL"},
        "errors": {"minItems": 1}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
