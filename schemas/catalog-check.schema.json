{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KokunoYumeto/mathematics-commons-pilot/raw/main/schemas/catalog-check.schema.json",
  "title": "Mathematics Commons catalog validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "inputs",
    "asset_manifests",
    "jobs",
    "release_assets",
    "release_asset_bytes",
    "packet_source_files",
    "packet_source_bytes",
    "zip_member_files_replayed",
    "nested_authorities_replayed",
    "asset_mode",
    "translation_entries",
    "formalization_entries",
    "portal_sections",
    "public_readback",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "math-commons-catalog-check/v1"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_meta",
        "jobs",
        "translations",
        "formalization",
        "portals",
        "readback",
        "translate_readback",
        "global_receipt",
        "gordan2_receipt",
        "mikami_receipt",
        "job_meta_schema",
        "job_schema",
        "translation_schema",
        "formalization_schema",
        "portal_schema",
        "asset_schema",
        "readback_schema",
        "portal_readback_schema",
        "check_schema",
        "schema_validator",
        "packer",
        "builder",
        "validator"
      ],
      "properties": {
        "job_meta": {
          "$ref": "#/$defs/identity"
        },
        "jobs": {
          "$ref": "#/$defs/identity"
        },
        "translations": {
          "$ref": "#/$defs/identity"
        },
        "formalization": {
          "$ref": "#/$defs/identity"
        },
        "portals": {
          "$ref": "#/$defs/identity"
        },
        "readback": {
          "$ref": "#/$defs/identity"
        },
        "translate_readback": {
          "$ref": "#/$defs/identity"
        },
        "global_receipt": {
          "$ref": "#/$defs/identity"
        },
        "gordan2_receipt": {
          "$ref": "#/$defs/identity"
        },
        "mikami_receipt": {
          "$ref": "#/$defs/identity"
        },
        "job_meta_schema": {
          "$ref": "#/$defs/identity"
        },
        "job_schema": {
          "$ref": "#/$defs/identity"
        },
        "translation_schema": {
          "$ref": "#/$defs/identity"
        },
        "formalization_schema": {
          "$ref": "#/$defs/identity"
        },
        "portal_schema": {
          "$ref": "#/$defs/identity"
        },
        "asset_schema": {
          "$ref": "#/$defs/identity"
        },
        "readback_schema": {
          "$ref": "#/$defs/identity"
        },
        "portal_readback_schema": {
          "$ref": "#/$defs/identity"
        },
        "check_schema": {
          "$ref": "#/$defs/identity"
        },
        "schema_validator": {
          "$ref": "#/$defs/identity"
        },
        "packer": {
          "$ref": "#/$defs/identity"
        },
        "builder": {
          "$ref": "#/$defs/identity"
        },
        "validator": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "asset_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes",
        "canonical_stream_bytes",
        "tree_sha256"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_stream_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "jobs": {
      "type": "integer",
      "minimum": 0
    },
    "release_assets": {
      "type": "integer",
      "minimum": 0
    },
    "release_asset_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "packet_source_files": {
      "type": "integer",
      "minimum": 0
    },
    "packet_source_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "zip_member_files_replayed": {
      "type": "integer",
      "minimum": 0
    },
    "nested_authorities_replayed": {
      "type": "integer",
      "minimum": 0
    },
    "asset_mode": {
      "enum": [
        "local_zip_replay",
        "catalog_only"
      ]
    },
    "translation_entries": {
      "type": "integer",
      "minimum": 0
    },
    "formalization_entries": {
      "type": "integer",
      "minimum": 0
    },
    "portal_sections": {
      "type": "integer",
      "minimum": 0
    },
    "public_readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "subject_commit",
        "release_tag",
        "release_id",
        "transport",
        "observed_date",
        "release_assets",
        "release_asset_bytes",
        "raw_files",
        "mismatches",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL"]
        },
        "subject_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^jobs-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[0-9]+$"
        },
        "release_id": {
          "type": "integer",
          "minimum": 1
        },
        "transport": {
          "const": "anonymous_https"
        },
        "observed_date": {
          "const": "2026-08-21"
        },
        "release_assets": {
          "type": "integer",
          "minimum": 0
        },
        "release_asset_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "raw_files": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": {"const": "PASS"},
        "errors": {"maxItems": 0}
      }
    },
    {
      "type": "object",
      "required": ["status", "errors"],
      "properties": {
        "status": {"const": "FAIL"},
        "errors": {"minItems": 1}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
