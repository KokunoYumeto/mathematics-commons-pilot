  "materials": [
    {
      "id": "open_license",
      "label": "Open license",
      "rule": "Preserve attribution, the source, the license, and all required notices; follow the license terms for adaptations."
    },
    {
      "id": "share_alike",
      "label": "ShareAlike",
      "rule": "Publish the translated adaptation under the required compatible ShareAlike license and preserve attribution."
    },
    {
      "id": "noncommercial_adaptable",
      "label": "Noncommercial license permitting adaptations",
      "rule": "Use this route only when the stated noncommercial license permits adaptations. Distribute the translation noncommercially; do not sell it or authorize commercial reuse; preserve attribution and any ShareAlike requirement."
    },
    {
      "id": "mixed_components",
      "label": "Mixed components",
      "rule": "Preserve the separate attribution and license notice for text, figures, code, fonts, and media; do not replace them silently with one blanket license."
    }
  ],
  "workflow": [
    {
      "step": 1,
      "action": "Choose one educational work and one exact target language, locale, script, and written standard."
    },
    {
      "step": 2,
      "action": "Freeze and record the exact source revision and its distribution terms."
    },
    {
      "step": 3,
      "action": "Translate bounded units with any capable local or hosted AI system; keep source-language and target-language editions separate and monolingual."
    },
    {
      "step": 4,
      "action": "Preserve formulas, figures, examples, exercises, answers, attribution, and component notices; record terminology and corrections."
    },
    {
      "step": 5,
      "action": "Return cumulative editable source, readable output, manifests, QA evidence, unresolved items, and the exact continuation point."
    },
    {
      "step": 6,
      "action": "Publish or hand back the complete checkpoint so another contributor can inspect, correct, replay, or continue it without restarting."
    }
  ],
